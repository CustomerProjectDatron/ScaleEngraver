module SampleProtractor

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":120.0,"Y":70.0,"Z":0.0}@

# SAMPLE: a half-circle protractor, 0 to 180 degrees, ticks and numbers inside the arc.
#
#   EngraveDial X=60 Y=10 Z=0 radius=50 kind=DialKind.Protractor
#
# The kind Protractor sets what a protractor needs: the range 0..180, a long tick every 10 degrees with
# a number on every second one, a tick every degree, a medium tick every 5 degrees, the sweep over the top
# from the left (0) to the right (180), ticks and numbers inside the circle, numbers not turned.
# Every one of these can be overridden, for example  inside=false  puts the ticks outside.
#
# The bottom line of the protractor is not part of the scale. The program selects the tool and sets Rpm,
# the feeds and the spindle. Z = 0 is the surface of the part.

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=200 finishing=800
    Spindle On

    EngraveDial X=60 Y=10 Z=0 radius=50 kind=DialKind.Protractor

    Spindle Off
    MoveToParkPosition
endprogram

end