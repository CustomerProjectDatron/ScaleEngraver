module SampleSpeedSquare

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":150.0,"Y":150.0,"Z":0.0}@

# SAMPLE: a speed square - the angle scale on its 45 degree edge and a millimetre ruler along the bottom edge.
#
# The square has its corner at (0, 0) and its legs along X and Y, 150 mm long.
#
#   EngraveAngleScale X=150 Y=0 Z=0 EndX=0 EndY=150 PivotX=0 PivotY=0 skipFirst=1 skipLast=1
#       the scale runs along the 45 degree edge from (150, 0) to (0, 150). The PIVOT is the corner (0, 0): every tick points
#       to it and the angles are seen from there, so the scale counts 0 to 90 degrees from the start point. A tick every
#       degree, a longer one every 5, a number every 10 degrees. skipFirst=1 / skipLast=1 leave out the numbers 0 and 90
#       in the tight corners; their ticks stay.
#
#   EngraveRuler X=0 Y=0 Z=0 length=150 skipFirst=1 skipLast=2
#       a millimetre ruler along the bottom edge; the number 0 at the corner and the last two numbers are left out.
#
# Instead of the end point the scale line can be given with length= and angle=, and angleStart= sets the number at the
# start point. The program sets the retract height (SafeZHeightForWorkpiece), Rpm and the feeds; the spindle is handled
# by the commands.

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=200 finishing=800

    EngraveAngleScale X=150 Y=0 Z=0 EndX=0 EndY=150 PivotX=0 PivotY=0 skipFirst=1 skipLast=1
    EngraveRuler X=0 Y=0 Z=0 length=150 skipFirst=1 skipLast=2

    MoveToParkPosition
endprogram

end
