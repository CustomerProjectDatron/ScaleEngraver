module SampleSpeedSquare

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":150.0,"Y":150.0,"Z":0.0}@

# SAMPLE: an angle scale on a straight edge, like on a speed square.
#
# You give three things: the PIVOT (the corner of the square the angles are measured from, nothing is engraved there),
# the START of the scale line and its END (or its length and direction). The numbers start at the start point with 0.
#
#   EngraveAngleScale X=10 Y=70 Z=0 EndX=60 EndY=70 PivotX=10 PivotY=20
#       the line runs from (10, 70) to (60, 70), the pivot is 50 mm below its start. The 0 is at the start point and the
#       45 at its end (the angle swept as seen from the pivot). Every tick is radial, pointing to the pivot: a tick every
#       degree, a longer one every 5, a number every 10 degrees.
#
#   EngraveAngleScale X=80 Y=50 Z=0 length=65 angle=0 PivotX=75 PivotY=20 majorStep=5 angleStart=10
#       the pivot is not above the start: the ticks lean, and the scale covers about 57 degrees over its 65 mm. angleStart=10
#       defines your own start value, here the first tick shows 10 and the numbers continue from there.
#
# The distances between the ticks follow the geometry of the pivot (tan), the numbers are your choice.
# The program sets the retract height (SafeZHeightForWorkpiece), Rpm and the feeds; the spindle is handled by the commands.

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=200 finishing=800

    EngraveAngleScale X=150 Y=0 Z=0 EndX=0 EndY=150 PivotX=0 PivotY=0 skipFirst=1 skipLast=1
    EngraveRuler(X=0 Y=0 Z=0 length=150 Millimeter skipLast=2 skipFirst=1)

    MoveToParkPosition
endprogram

end
