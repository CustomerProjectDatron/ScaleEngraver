module SampleEdgeRuler

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":30.0,"Y":130.0,"Z":0.0}@

# SAMPLE: a vertical centimetre ruler along the left edge of a part, ticks pointing into the part.
#
#   EngraveRuler X=0 Y=20 Z=0 length=100 kind=ScaleKind.Centimeter angle=90 below=true skipFirst=true
#
#   kind=Centimeter   same ticks as a millimetre ruler, the numbers are centimetres: 1, 2, 3 ... 10
#   angle=90          the ruler runs upwards (+Y); 0 = to the right
#   below=true        ticks and numbers on the right-hand side of the running direction, which is the
#                     part side (+X) of the edge X = 0; the default is the left-hand side
#   skipFirst=true    no tick and no number at 0, directly on the edge of the part
#
# The program selects the tool and sets Rpm, the feeds and the spindle. Z = 0 is the surface of the part.

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=200 finishing=800
    Spindle On

    EngraveRuler X=0 Y=20 Z=0 length=100 kind=ScaleKind.Centimeter angle=90 below=true skipFirst=true

    Spindle Off
    MoveToParkPosition
endprogram

end