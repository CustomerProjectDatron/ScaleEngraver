module SampleDialVariants

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":180.0,"Y":60.0,"Z":0.0}@

# SAMPLE: three small percent dials 0..100 side by side - the three number orientations.
#
#   Tangential   the numbers follow the circle, their top points away from the centre (the usual look;
#                numbers at the bottom stand upside down)
#   Radial       the numbers run along the radius; on the left half they are turned by 180 degrees so
#                that they stay readable from the right side
#   Horizontal   the numbers are not turned at all (best for small dials read from one side)
#
# kind=DialKind.Percent is a full circle 0..100 with a long tick and a number every 10. The tick length
# of a dial defaults to 20 percent of the radius (at most 6 mm), here 4 mm.
#
# The program selects the tool and sets Rpm, the feeds and the spindle. Z = 0 is the surface of the part.

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=200 finishing=800
    Spindle On

    EngraveDial X=30 Y=30 Z=0 radius=20 kind=DialKind.Percent orientation=NumberOrientation.Tangential
    EngraveDial X=90 Y=30 Z=0 radius=20 kind=DialKind.Percent orientation=NumberOrientation.Radial
    EngraveDial X=150 Y=30 Z=0 radius=20 kind=DialKind.Percent orientation=NumberOrientation.Horizontal

    Spindle Off
    MoveToParkPosition
endprogram

end