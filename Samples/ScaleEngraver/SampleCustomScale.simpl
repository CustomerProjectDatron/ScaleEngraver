module SampleCustomScale

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":120.0,"Y":100.0,"Z":10.0}@

# SAMPLE: your own scales - you say from which value to which value.
#
#   EngraveRuler X=10 Y=70 Z=0 length=100 valueStart=20 valueEnd=70
#       a ruler 100 mm long that shows 20 at its start and 70 at its end: 50 value units over 100 mm.
#       The long ticks with a number sit on 20, 25 ... by themselves (1, 2 or 5 times a power of ten,
#       about ten numbers); set majorStep=10 to choose the distance yourself.
#
#   EngraveRuler X=10 Y=40 Z=0 length=100 valueStart=-50 valueEnd=50
#       negative values are fine: the zero sits in the middle of the ruler.
#
#   EngraveDial X=100 Y=20 Z=0 radius=14 kind=DialKind.Gauge valueStart=20 valueEnd=80
#       and a gauge that shows 20 to 80 over its sweep.
#
# The ticks sit on multiples of the step, so a range such as 15 to 85 starts with a short tick at 15
# and has its long ticks at 20, 30 ... The program sets tool, Rpm, the feeds and the spindle.

using Base
using ScaleEngraver
import Development
import File
import MillingCyclesUtilities

export program Main
    SafeZHeightForWorkpiece = 15
    PrePositioning
#    MillingCyclesUtilities::ExecuteMillingCycle
 
    SetFeedTechnology plunge=200 finishing=800
    Rpm = 13000
    Spindle On
    
    EngraveRuler X=10 Y=70 Z=10 length=100 valueStart=20 valueEnd=70 depth=1
    EngraveRuler X=10 Y=40 Z=10 length=100 valueStart=-50 valueEnd=50
    EngraveDial X=100 Y=20 Z=10 radius=14 kind=DialKind.Gauge valueStart=20 valueEnd=80

    Spindle Off
    MoveToParkPosition
endprogram

end
