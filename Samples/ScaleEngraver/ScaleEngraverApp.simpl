module ScaleEngraverApp

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":120.0,"Y":100.0,"Z":0.0}@

# Operator interface of the ScaleEngraver library: choose the scale, enter where it goes and how big it is,
# and the scale is engraved. Two dialogs; everything that is not asked has the library default
# (see ScaleEngraver: tick length 6 mm, factor 0.7, depth 0.1 mm ...).

using Base
using DialogUtilities
using ScaleEngraver

export program Main
    scales:any[] = { "Ruler in millimetres", "Ruler in centimetres", "Ruler in inches (fractions)", "Dial 0 to 360 degrees", "Dial 0 to 100 percent", "Gauge 0 to 100", "Protractor 0 to 180" }
    scaleSelection:InputSelection = { scales, 0 }
    machineInputs:InputParameter[] = {
        SelectionParameter description="Scale" selection=scaleSelection,
        StringParameter description="Tool name (empty = tool in spindle)" default="",
        NumberParameter description="Spindle speed" default=13000 unit="rpm",
        NumberParameter description="Feed for the cuts" default=1000 unit="mm/min",
        NumberParameter description="Feed for plunging into the part" default=250 unit="mm/min"
    }
    InputDialog parameters <- machineInputs caption="Scale engraver"
    choice = machineInputs[0].SelectionValue.Selected
    toolName = machineInputs[1].StringValue
    rpmValue = machineInputs[2].NumberValue
    feedValue = machineInputs[3].NumberValue
    plungeValue = machineInputs[4].NumberValue

    if choice <= 2
        rulerInputs:InputParameter[] = {
            NumberParameter description="Start X" default=10 unit="mm",
            NumberParameter description="Start Y" default=10 unit="mm",
            NumberParameter description="Length" default=100 unit="mm",
            NumberParameter description="Direction (0 = to the right, 90 = upwards)" default=0 unit="deg",
            NumberParameter description="Longest tick" default=6 unit="mm",
            NumberParameter description="Depth" default=0.1 unit="mm",
            BooleanParameter description="Ticks and numbers below / right of the direction" default=false,
            BooleanParameter description="Leave out the first tick and number (part edge)" default=false
        }
        InputDialog parameters <- rulerInputs caption="Scale engraver - ruler"
        chosenRuler = ScaleKind.Millimeter
        if choice == 1
            chosenRuler = ScaleKind.Centimeter
        endif
        if choice == 2
            chosenRuler = ScaleKind.Inch
        endif
        Absolute
        if toolName <> ""
            Tool name=toolName newRpm=rpmValue skipRestoring
        endif
        SafeZHeightForWorkpiece = 15
        Rpm = rpmValue
        SetFeedTechnology plunge=plungeValue finishing=feedValue
        EngraveRuler X=rulerInputs[0].NumberValue Y=rulerInputs[1].NumberValue Z=0 length=rulerInputs[2].NumberValue kind=chosenRuler angle=rulerInputs[3].NumberValue tickLength=rulerInputs[4].NumberValue depth=rulerInputs[5].NumberValue below=rulerInputs[6].BooleanValue skipFirst=rulerInputs[7].BooleanValue
    else
        dialInputs:InputParameter[] = {
            NumberParameter description="Centre X" default=60 unit="mm",
            NumberParameter description="Centre Y" default=50 unit="mm",
            NumberParameter description="Radius" default=30 unit="mm",
            NumberParameter description="Longest tick" default=6 unit="mm",
            NumberParameter description="Depth" default=0.1 unit="mm",
            BooleanParameter description="Leave out the first tick and number" default=false
        }
        InputDialog parameters <- dialInputs caption="Scale engraver - dial"
        chosenDial = DialKind.Degrees
        if choice == 4
            chosenDial = DialKind.Percent
        endif
        if choice == 5
            chosenDial = DialKind.Gauge
        endif
        if choice == 6
            chosenDial = DialKind.Protractor
        endif
        Absolute
        if toolName <> ""
            Tool name=toolName newRpm=rpmValue skipRestoring
        endif
        SafeZHeightForWorkpiece = 15
        Rpm = rpmValue
        SetFeedTechnology plunge=plungeValue finishing=feedValue
        EngraveDial X=dialInputs[0].NumberValue Y=dialInputs[1].NumberValue Z=0 radius=dialInputs[2].NumberValue kind=chosenDial tickLength=dialInputs[3].NumberValue depth=dialInputs[4].NumberValue skipFirst=dialInputs[5].BooleanValue
    endif
    MoveToParkPosition
endprogram

end