module ScaleEngraverSample

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":120.0,"Y":100.0,"Z":0.0}@

# SAMPLE: the smallest example - a 100 mm ruler and a dial, one command each.
#
#   EngraveRuler X=10 Y=10 Z=0 length=100      a millimetre ruler: tick every 1 mm, medium every 5 mm,
#                                          long tick with a number every 10 mm
#   EngraveDial  X=60 Y=60 Z=0 radius=28       a dial 0..360 degrees: number every 30, tick every 5 degrees
#
# Everything else has a default: tick length 6 mm (all other ticks are shorter by a factor of 0.7 per level),
# numbers half as high as the longest tick, depth 0.1 mm, line along the ticks. Add parameters only
# where you want something different, for example  tickLength=8  or  depth=0.15.
#
# The program selects the tool and sets Rpm and the feeds; the commands take care of the spindle (MillingCyclesUtilities::ExecuteMillingCycle).
# Like in the milling cycles:
#   SafeZHeightForWorkpiece   the height the tool retracts to between two engravings (PrePositioning)
#   SetFeedTechnology         plunge = the move into the material, finishing = the cut along the tick or line
#   Z=0                       the height of the surface of the part; every depth is measured from it
#   feedHeight=1              (default) the height above Z where the plunge feed starts
#   infeedZ                   (default = the depth) maximum depth per cut, for example
#     EngraveRuler X=10 Y=10 Z=0 length=100 depth=0.3 infeedZ=0.1     three cuts of 0.1 mm

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=250 finishing=1000

    EngraveRuler X=10 Y=10 Z=0 length=100
    EngraveDial X=60 Y=60 Z=0 radius=28

    MoveToParkPosition
endprogram

end