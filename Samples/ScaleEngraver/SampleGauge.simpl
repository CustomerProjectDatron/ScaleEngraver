module SampleGauge

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @
@ WorkpieceGeometry :"MinEdge":{"X":0.0,"Y":0.0,"Z":-10.0},"MaxEdge":{"X":100.0,"Y":100.0,"Z":0.0}@

# SAMPLE: a gauge face (pressure, temperature, level ...) with a 270 degree scale 0..100.
#
#   EngraveDial X=50 Y=50 Z=0 radius=30 kind=DialKind.Gauge
#
# The kind Gauge runs from the lower left (7:30 o'clock) clockwise over the top to the lower right
# (4:30), values 0..100, a long tick every 10, a number on every second one. Change the values with
#   valueEnd=60 majorStep=10      a 0..60 gauge with a long tick every 10
#   valueStart=20 valueEnd=80     your own scale: the same sweep shows 20 to 80
# and the sweep with startAngle= / endAngle= (an end angle smaller than the start angle runs clockwise).
#
# The program selects the tool and sets Rpm, the feeds and the spindle. Z = 0 is the surface of the part.

using Base
using ScaleEngraver

export program Main
    Absolute
    SafeZHeightForWorkpiece = 15
    Rpm = 13000
    SetFeedTechnology plunge=200 finishing=800
    Spindle On

    EngraveDial X=50 Y=50 Z=0 radius=30 kind=DialKind.Gauge

    Spindle Off
    MoveToParkPosition
endprogram

end