module ScaleEngraver

@ UserVisible = false @
@ SystemModule = true @
@ Author = "Benjamin Boeck" @


# Engraves linear and circular scales (major and minor ticks plus value labels).
#
# The module is split in two layers that never mix:
# 1. Planning - PlanLinearScale / PlanCircularScale turn a parameter structure into a ScalePlan
#    (plain data: tick lines, arcs, labels). No machine command is issued, so a plan can be
#    inspected, previewed, serialised (System::ValueToJson) or served by a future web API.
# 2. Execution - EngraveScalePlan turns a ScalePlan into motion and text engraving. It is pure
#    motion: the calling program selects the tool and sets Rpm, Feed and Spindle On/Off.
#
# Units: lengths in mm, angles in degrees (counter-clockwise from +X), depths are positive
# numbers = how deep below the workpiece surface (Z = 0); the library converts them to the Z values

using Base
using Engrave
import Math
import String

# ---------------------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------------------

@doc: Side of the scale line on which the ticks and labels are drawn.
Linear scale: Positive = left of the scale direction (up for a scale along +X), Negative = right.
Circular scale: Positive = outside of the circle, Negative = inside. @
export enumeration TickSide (Positive, Negative)

@doc: How the labels of a circular scale are rotated.
Tangential = text follows the circle (text up points away from the centre),
Radial = text runs along the radius (flipped on the left half to stay readable),
Horizontal = text is not rotated. @
export enumeration LabelOrientation (Tangential, Radial, Horizontal)

@doc: Horizontal alignment of a label relative to its engraving position. @
export enumeration LabelAlignment (Left, Center, Right)

@doc: Length and engraving depth of one tick class (major or minor). @
export structure TickStyle (
    tickLength:number
        @doc: ![](images/tickLength.png)

Length of the tick in mm, measured from the scale line away from it.@,
    tickDepth:number
        @doc: ![](images/tickDepth.png)

Engraving depth of the tick in mm, positive = depth below the surface.@
)

@doc: Text settings of the value labels. @
export structure LabelSettings (
    labelHeight:number
        @doc: ![](images/labelHeight.png)

Font size: character height in mm.@,
    labelWidth:number
        @doc: ![](images/labelWidth.png)

Character width in mm.@,
    labelDepth:number
        @doc: ![](images/depth.png)

Engraving depth of the text in mm, positive = depth below the surface.@,
    labelOffset:number
        @doc: ![](images/labelOffset.png)

Gap in mm between the end of the major tick and the text.@,
    decimals:number
        @doc: Number of decimal places of the label text.@,
    labelEvery:number
        @doc: ![](images/labelEvery.png)

1 labels every major tick, 2 every second major tick and so on.@,
    skipFirstLabel:boolean
        @doc: ![](images/skipFirstLabel.png)

No label at the first major tick, e.g. when it lies on the border of the part.@,
    skipLastLabel:boolean
        @doc: ![](images/skipLastLabel.png)

No label at the last major tick. Ignored for a closed 360 degree circle.@,
    fractionDenominator:number
        @doc: ![](images/fractionDenominator.png)

0 = labels are decimal numbers. Above 0 = labels are fractions of 1/denominator, e.g. 8 gives 1/8, 1/4, 3/8 and 1 1/2. The value is rounded to the nearest 1/denominator and reduced. Typical values: 2, 4, 8, 16.@
)

@doc: Value range of a scale and its tick spacing. @
export structure ScaleDivision (
    valueStart:number
        @doc: Scale value at the start of the scale.@,
    valueEnd:number
        @doc: Scale value at the end of the scale.@,
    majorStep:number
        @doc: ![](images/majorStep.png)

Value distance between two major ticks.@,
    minorDivisions:number
        @doc: ![](images/minorDivisions.png)

Number of minor intervals per major interval. 10 gives nine minor ticks between two major ticks.@,
    skipFirstTick:boolean
        @doc: ![](images/skipFirstTick.png)

Do not engrave the tick (and its label) at valueStart, e.g. when it lies on the edge of the part.@,
    skipLastTick:boolean
        @doc: ![](images/skipLastTick.png)

Do not engrave the tick (and its label) at the end of the range.@,
    mediumEvery:number
        @doc: ![](images/mediumEvery.png)

Intermediate ticks: every n-th minor interval gets a medium tick (e.g. 5 with minorDivisions 10 gives a tick at 5 between the major ticks at 0 and 10). 0 = no medium ticks. Major ticks win where both coincide.@
)

@doc: A straight scale. It starts at (originX, originY) and runs rotationAngle degrees from +X
over scaleLength mm. The scale value valueStart is at the origin, valueEnd at the far end. @
export structure LinearScale (
    originX:number
        @doc: X of the start of the scale in mm.@,
    originY:number
        @doc: Y of the start of the scale in mm.@,
    scaleLength:number
        @doc: ![](images/scaleLength.png)

Length of the scale in mm from valueStart to valueEnd.@,
    rotationAngle:number
        @doc: ![](images/rotationAngle.png)

Direction of the scale in degrees, 0 = along +X, counter-clockwise.@,
    division:ScaleDivision
        @doc: Value range and tick spacing.@,
    side:TickSide
        @doc: ![](images/side_positive.png) ![](images/side_negative.png)

Side of the scale line on which ticks and labels are engraved.@,
    majorTick:TickStyle
        @doc: Length and depth of the major ticks.@,
    minorTick:TickStyle
        @doc: Length and depth of the minor ticks.@,
    mediumTick:TickStyle
        @doc: Length and depth of the medium (intermediate) ticks, see ScaleDivision.mediumEvery.@,
    labelFormat:LabelSettings
        @doc: Text settings of the labels.@,
    baselineDepth:number
        @doc: ![](images/baselineDepth.png)

Depth of the scale line itself in mm (positive = depth below the surface); 0 = the line is not engraved.@
)

@doc: A circular scale on a circle around (centerX, centerY). The scale runs from startAngle to
endAngle (degrees, counter-clockwise; endAngle < startAngle runs clockwise). A sweep of 360
degrees closes the circle: the closing tick and label are not engraved twice. @
export structure CircularScale (
    centerX:number
        @doc: X of the circle centre in mm.@,
    centerY:number
        @doc: Y of the circle centre in mm.@,
    radius:number
        @doc: ![](images/radius.png)

Radius of the scale circle in mm; the ticks start on this circle.@,
    startAngle:number
        @doc: ![](images/startAngle.png)

Angle of valueStart in degrees, 0 = +X, 90 = +Y (12 o'clock), counter-clockwise.@,
    endAngle:number
        @doc: ![](images/endAngle.png)

Angle of valueEnd in degrees. Smaller than startAngle runs clockwise.@,
    division:ScaleDivision
        @doc: Value range and tick spacing.@,
    side:TickSide
        @doc: ![](images/side_positive.png) ![](images/side_negative.png)

Positive = ticks and labels outside the circle, Negative = inside.@,
    majorTick:TickStyle
        @doc: Length and depth of the major ticks.@,
    minorTick:TickStyle
        @doc: Length and depth of the minor ticks.@,
    mediumTick:TickStyle
        @doc: Length and depth of the medium (intermediate) ticks, see ScaleDivision.mediumEvery.@,
    labelFormat:LabelSettings
        @doc: Text settings of the labels.@,
    orientation:LabelOrientation
        @doc: ![](images/orientation_tangential.png) ![](images/orientation_radial.png) ![](images/orientation_horizontal.png)

How the labels are rotated.@,
    baselineDepth:number
        @doc: ![](images/baselineDepth.png)

Depth of the circle line itself in mm (positive = depth below the surface); 0 = the line is not engraved.@
)

@doc: An inch ruler. The unit is halved again and again: whole units get the longest tick and a big number,
halves, quarters, eighths and so on get shorter ticks and, down to a level you choose, a small fraction
(1/2, 1/4, 3/4). levels = 4 ends at sixteenths, levels = 5 at thirty-seconds. The scale starts at
(originX, originY), runs rotationAngle degrees from +X over scaleLength and counts whole units from valueStart. @
export structure FractionScale (
    originX:number
        @doc: X of the start of the scale (in the unit of the control).@,
    originY:number
        @doc: Y of the start of the scale.@,
    scaleLength:number
        @doc: ![](images/scaleLength.png)

Length of the scale from valueStart to valueEnd.@,
    rotationAngle:number
        @doc: ![](images/rotationAngle.png)

Direction of the scale in degrees, 0 = along +X, counter-clockwise.@,
    valueStart:number
        @doc: Value at the start of the scale in whole units, e.g. 0. Use a whole number.@,
    valueEnd:number
        @doc: Value at the end of the scale in whole units, e.g. 6 for 6 inch.@,
    levels:number
        @doc: ![](images/levels.png)

How often the unit is halved: 1 = halves, 2 = quarters, 3 = eighths, 4 = sixteenths, 5 = thirty-seconds. Every level has its own tick length.@,
    tickStyles:TickStyle[]
        @doc: ![](images/tickStyles.png)

Tick length and depth per level: entry 0 for the whole units, 1 for the halves, 2 for the quarters and so on (levels + 1 entries, longest first).@,
    unitLabel:LabelSettings
        @doc: ![](images/unitLabel.png)

Text of the big whole-unit numbers (1, 2, 3 ...) above the longest ticks: size, depth, gap, label every n-th unit, skip first or last.@,
    fractionLabel:LabelSettings
        @doc: ![](images/fractionLabel.png)

Text of the small fractions (1/2, 1/4, 3/4) above the shorter ticks, usually smaller than the unit numbers. Only the fractional part is written.@,
    fractionLabelLevel:number
        @doc: ![](images/fractionLabelLevel.png)

Fractions are written down to this level: 0 = none, 1 = halves, 2 = also quarters, 3 = also eighths. Finer ticks get no number.@,
    side:TickSide
        @doc: ![](images/side_positive.png) ![](images/side_negative.png)

Side of the scale line for ticks and labels: Positive = left of the direction, Negative = right.@,
    skipFirstTick:boolean
        @doc: ![](images/skipFirstTick.png)

Do not engrave the tick and its number at valueStart.@,
    skipLastTick:boolean
        @doc: ![](images/skipLastTick.png)

Do not engrave the tick and its number at valueEnd.@,
    baselineDepth:number
        @doc: ![](images/baselineDepth.png)

Depth of the scale line itself in mm (positive = depth below the surface); 0 = the line is not engraved.@
)
@doc: Heights and approach of the engraving motion. Tool, spindle speed, feeds and spindle on/off are NOT
part of the library: the calling program sets them (Tool, Rpm, Feed, Spindle On) before the
engraving call. Ticks and lines: rapid to retractZ, rapid to the start, rapid down to approachZ (a little above the
surface), then feed down to the depth and cut horizontally. Between two engravings the tool always moves up,
over and down again - no connecting move at depth. Text: StandardTextEngrave does its own
approach; retractZ is passed as its rapid level (strokeRapidZ), approachZ as its cutting level (strokeCuttingZ). @
export structure EngraveHeights (
    retractZ:number
        @doc: ![](images/retractZ.png)

Clearance height in mm between two engravings (Z = 0 is the surface).@,
    approachZ:number
        @doc: ![](images/approachZ.png)

Height in mm just above the surface where the rapid move ends and the feed move into the material starts, e.g. 0.5.@,
    safeZ:number
        @doc: ![](images/safeZ.png)

Height in mm for the final retract after the last engraving.@
)

# Plan elements (pure data)
@doc: A straight engraved line: a tick, or the baseline of a linear scale. @
export structure ScaleLine (
    x1:number
        @doc: Start X in mm.@,
    y1:number
        @doc: Start Y in mm.@,
    x2:number
        @doc: End X in mm.@,
    y2:number
        @doc: End Y in mm.@,
    lineDepth:number
        @doc: ![](images/depth.png)

Engraving depth in mm, positive = depth below the surface.@,
    isMajor:boolean
        @doc: True for a major tick and for a baseline.@
)

@doc: An engraved circular arc: the baseline of a circular scale. @
export structure ScaleArc (
    arcCenterX:number
        @doc: Centre X in mm.@,
    arcCenterY:number
        @doc: Centre Y in mm.@,
    arcRadius:number
        @doc: Radius in mm.@,
    arcStart:number
        @doc: Start angle in degrees.@,
    arcEnd:number
        @doc: End angle in degrees; smaller than the start angle runs clockwise.@,
    arcDepth:number
        @doc: ![](images/depth.png)

Engraving depth in mm, positive = depth below the surface.@
)

@doc: One engraved text. Vertically centred on (x, y); horizontally placed by alignment. @
export structure ScaleLabel (
    text:string
        @doc: The label text.@,
    x:number
        @doc: X of the text position in mm.@,
    y:number
        @doc: Y of the text position in mm.@,
    rotation:number
        @doc: Text rotation in degrees, counter-clockwise.@,
    textHeight:number
        @doc: Character height in mm.@,
    textWidth:number
        @doc: Character width in mm.@,
    textDepth:number
        @doc: ![](images/depth.png)

Engraving depth in mm, positive = depth below the surface.@,
    alignment:LabelAlignment
        @doc: Horizontal alignment relative to (x, y).@
)

@doc: The complete result of planning a scale: everything that will be engraved, as data. @
export structure ScalePlan (
    lines:ScaleLine[]
        @doc: Baseline (linear scales) and all ticks, in scale order.@,
    arcs:ScaleArc[]
        @doc: Baseline arc of a circular scale (empty when baselineDepth is 0).@,
    labels:ScaleLabel[]
        @doc: All labels, in scale order.@
)

# Internal: one tick position along the scale, fraction = 0 at valueStart, 1 at valueEnd
structure ScaleTick (value:number, fraction:number, isMajor:boolean, isMedium:boolean, hasLabel:boolean, text:string)

# ---------------------------------------------------------------------------------------
# Constructors
# ---------------------------------------------------------------------------------------

@doc: Creates the length and depth of one tick class (major or minor). @
export program NewTickStyle (
    tickLength:number
        @doc: ![](images/tickLength.png)

Length of the tick in mm.@
    tickDepth:number
        @doc: ![](images/tickDepth.png)

Engraving depth in mm, positive = depth below the surface.@
    ) returns TickStyle
    return TickStyle = {tickLength, tickDepth}
endprogram

@doc: Creates the text settings of the labels. Only the font size is mandatory. @
export program NewLabelSettings (
    labelHeight:number
        @doc: ![](images/labelHeight.png)

Font size: character height in mm.@
    optional labelWidth:number
        @doc: ![](images/labelWidth.png)

Character width in mm. Default: 0.7 x labelHeight.@
    optional labelDepth:number
        @doc: ![](images/depth.png)

Engraving depth of the text in mm (positive = depth below the surface). Default: 0.1.@
    optional labelOffset:number
        @doc: ![](images/labelOffset.png)

Gap in mm between the end of the major tick and the text. Default: 0.3 x labelHeight.@
    optional decimals:number
        @doc: Decimal places of the label text. Default: 0.@
    optional labelEvery:number
        @doc: ![](images/labelEvery.png)

Label every n-th major tick. Default: 1 (every major tick).@
    optional skipFirstLabel:boolean
        @doc: ![](images/skipFirstLabel.png)

No label at the first major tick (e.g. the 0 on the part edge). Default: false.@
    optional skipLastLabel:boolean
        @doc: ![](images/skipLastLabel.png)

No label at the last major tick. Default: false.@
    optional fractionDenominator:number
        @doc: ![](images/fractionDenominator.png)

0 = decimal numbers. Above 0 = labels as fractions of 1/denominator, e.g. 8 for eighths (1/8, 1/4, 3/8, 1 1/2). Default: 0.@
    ) returns LabelSettings
    if not labelWidth hasvalue
        labelWidth = labelHeight * 0.7
    endif
    if not labelDepth hasvalue
        labelDepth = 0.1
    endif
    if not labelOffset hasvalue
        labelOffset = labelHeight * 0.3
    endif
    if not decimals hasvalue
        decimals = 0
    endif
    if not labelEvery hasvalue
        labelEvery = 1
    endif
    if not skipFirstLabel hasvalue
        skipFirstLabel = false
    endif
    if not skipLastLabel hasvalue
        skipLastLabel = false
    endif
    if not fractionDenominator hasvalue
        fractionDenominator = 0
    endif
    return LabelSettings = {labelHeight, labelWidth, labelDepth, labelOffset, decimals, labelEvery, skipFirstLabel, skipLastLabel, fractionDenominator}
endprogram

@doc: Creates the value range and tick spacing of a scale, for example 0..100 with a major tick
every 10 and ten minor intervals per major interval. @
export program NewScaleDivision (
    valueStart:number
        @doc: Scale value at the start of the scale.@
    valueEnd:number
        @doc: Scale value at the end of the scale.@
    majorStep:number
        @doc: ![](images/majorStep.png)

Value distance between two major ticks.@
    optional minorDivisions:number
        @doc: ![](images/minorDivisions.png)

Minor intervals per major interval. Default: 10.@
    optional skipFirstTick:boolean
        @doc: ![](images/skipFirstTick.png)

Do not engrave the tick (and its label) at valueStart. Default: false.@
    optional skipLastTick:boolean
        @doc: ![](images/skipLastTick.png)

Do not engrave the tick (and its label) at the end of the range. Default: false.@
    optional mediumEvery:number
        @doc: ![](images/mediumEvery.png)

Medium (intermediate) tick every n-th minor interval, e.g. 5 with minorDivisions 10. Default: 0 (none).@
    ) returns ScaleDivision
    if not minorDivisions hasvalue
        minorDivisions = 10
    endif
    if not skipFirstTick hasvalue
        skipFirstTick = false
    endif
    if not skipLastTick hasvalue
        skipLastTick = false
    endif
    if not mediumEvery hasvalue
        mediumEvery = 0
    endif
    return ScaleDivision = {valueStart, valueEnd, majorStep, minorDivisions, skipFirstTick, skipLastTick, mediumEvery}
endprogram

@doc: Creates the heights of the engraving motion. @
export program NewEngraveHeights (
    optional retractZ:number
        @doc: ![](images/retractZ.png)

Clearance height in mm between two engravings. Default: 2.@
    optional approachZ:number
        @doc: ![](images/approachZ.png)

Height in mm just above the surface where the feed move into the material starts. Default: 0.5.@
    optional safeZ:number
        @doc: ![](images/safeZ.png)

Height in mm for the final retract. Default: 20.@
    ) returns EngraveHeights
    if not retractZ hasvalue
        retractZ = 2
    endif
    if not approachZ hasvalue
        approachZ = 0.5
    endif
    if not safeZ hasvalue
        safeZ = 20
    endif
    return EngraveHeights = {retractZ, approachZ, safeZ}
endprogram

@doc: Creates a straight scale (ruler). The scale value valueStart is at the origin. @
export program NewLinearScale (
    originX:number
        @doc: X of the start of the scale in mm.@
    originY:number
        @doc: Y of the start of the scale in mm.@
    scaleLength:number
        @doc: ![](images/scaleLength.png)

Length of the scale in mm.@
    division:ScaleDivision
        @doc: Value range and tick spacing, see NewScaleDivision.@
    majorTick:TickStyle
        @doc: Length and depth of the major ticks, see NewTickStyle.@
    minorTick:TickStyle
        @doc: Length and depth of the minor ticks, see NewTickStyle.@
    labelFormat:LabelSettings
        @doc: Text settings of the labels, see NewLabelSettings.@
    optional mediumTick:TickStyle
        @doc: Medium (intermediate) tick style, used where division.mediumEvery applies. Default: halfway between the major and the minor tick.@
    optional rotationAngle:number
        @doc: ![](images/rotationAngle.png)

Direction of the scale in degrees, 0 = along +X. Default: 0.@
    optional side:TickSide
        @doc: ![](images/side_positive.png) ![](images/side_negative.png)

Side of the scale line for ticks and labels. Default: TickSide.Positive (left of the direction, up for 0 degrees).@
    optional baselineDepth:number
        @doc: ![](images/baselineDepth.png)

Depth of the scale line in mm (positive = depth below the surface); 0 = not engraved. Default: 0.@
    ) returns LinearScale
    if not mediumTick hasvalue
        mediumTick = TickStyle = {(majorTick.tickLength + minorTick.tickLength) / 2, (majorTick.tickDepth + minorTick.tickDepth) / 2}
    endif
    if not rotationAngle hasvalue
        rotationAngle = 0
    endif
    if not side hasvalue
        side = TickSide.Positive
    endif
    if not baselineDepth hasvalue
        baselineDepth = 0
    endif
    return LinearScale = {originX, originY, scaleLength, rotationAngle, division, side, majorTick, minorTick, mediumTick, labelFormat, baselineDepth}
endprogram

@doc: Creates a circular scale (dial, protractor). By default it runs clockwise from 12 o'clock
once around the circle. @
export program NewCircularScale (
    centerX:number
        @doc: X of the circle centre in mm.@
    centerY:number
        @doc: Y of the circle centre in mm.@
    radius:number
        @doc: ![](images/radius.png)

Radius of the scale circle in mm.@
    division:ScaleDivision
        @doc: Value range and tick spacing, see NewScaleDivision.@
    majorTick:TickStyle
        @doc: Length and depth of the major ticks, see NewTickStyle.@
    minorTick:TickStyle
        @doc: Length and depth of the minor ticks, see NewTickStyle.@
    labelFormat:LabelSettings
        @doc: Text settings of the labels, see NewLabelSettings.@
    optional mediumTick:TickStyle
        @doc: Medium (intermediate) tick style, used where division.mediumEvery applies. Default: halfway between the major and the minor tick.@
    optional startAngle:number
        @doc: ![](images/startAngle.png)

Angle of valueStart in degrees, 0 = +X, 90 = 12 o'clock. Default: 90.@
    optional endAngle:number
        @doc: ![](images/endAngle.png)

Angle of valueEnd in degrees; smaller than startAngle runs clockwise. Default: startAngle - 360 (one full turn clockwise).@
    optional side:TickSide
        @doc: ![](images/side_positive.png) ![](images/side_negative.png)

Positive = ticks and labels outside the circle, Negative = inside. Default: Positive.@
    optional orientation:LabelOrientation
        @doc: ![](images/orientation_tangential.png) ![](images/orientation_radial.png) ![](images/orientation_horizontal.png)

Label rotation. Default: LabelOrientation.Tangential.@
    optional baselineDepth:number
        @doc: ![](images/baselineDepth.png)

Depth of the circle line in mm (positive = depth below the surface); 0 = not engraved. Default: 0.@
    ) returns CircularScale
    if not mediumTick hasvalue
        mediumTick = TickStyle = {(majorTick.tickLength + minorTick.tickLength) / 2, (majorTick.tickDepth + minorTick.tickDepth) / 2}
    endif
    if not startAngle hasvalue
        startAngle = 90
    endif
    if not endAngle hasvalue
        endAngle = startAngle - 360
    endif
    if not side hasvalue
        side = TickSide.Positive
    endif
    if not orientation hasvalue
        orientation = LabelOrientation.Tangential
    endif
    if not baselineDepth hasvalue
        baselineDepth = 0
    endif
    return CircularScale = {centerX, centerY, radius, startAngle, endAngle, division, side, majorTick, minorTick, mediumTick, labelFormat, orientation, baselineDepth}
endprogram

# ---------------------------------------------------------------------------------------
# Planning layer - no machine commands below this line until "Execution layer"
# ---------------------------------------------------------------------------------------

function SideSign (side:TickSide) returns number
    if side == TickSide.Negative
        return -1
    endif
    return 1
endfunction

@doc: Writes a value as a fraction for inch scales: the value is rounded to the nearest 1/denominator and reduced,
for example 0.375 with denominator 8 gives 3/8, 1.5 gives 1 1/2 and 2 gives 2. @
program FractionText (
    value:number
        @doc: The value to write.@
    denominator:number
        @doc: Whole number above 0: the value is rounded to the nearest 1/denominator.@
    ) returns string
    total = Math::Round(Math::Abs(value) * denominator)
    whole = Math::Floor(total / denominator)
    remainder = total - whole * denominator
    result = ValueToString(whole)
    if remainder > 0
        a = remainder
        b = denominator
        while b > 0
            t = b
            b = a - Math::Floor(a / b) * b
            a = t
        endwhile
        fraction = ValueToString(remainder / a) + "/" + ValueToString(denominator / a)
        if whole > 0
            result = result + " " + fraction
        else
            result = fraction
        endif
    endif
    if value < 0 and total > 0
        result = "-" + result
    endif
    return result
endprogram

@doc: Computes the ticks along the value range: position (fraction of the range), major or minor,
and the label text. closeRing = true drops the tick at valueEnd (closed 360 degree circle). Ticks
removed by skipFirstTick / skipLastTick are not part of the result. @
program BuildTicks (
    division:ScaleDivision
        @doc: Value range and tick spacing.@
    labelFormat:LabelSettings
        @doc: Which major ticks get a label, and how many decimals.@
    closeRing:boolean
        @doc: True for a closed circle: the tick at valueEnd coincides with the one at valueStart.@
    ) returns ScaleTick[]
    ticks:ScaleTick[] = {}
    span = division.valueEnd - division.valueStart
    minorCount = Math::Round(division.minorDivisions)
    if minorCount < 1
        minorCount = 1
    endif
    labelEvery = Math::Round(labelFormat.labelEvery)
    if labelEvery < 1
        labelEvery = 1
    endif
    minorStep = division.majorStep / minorCount
    tickCount = Math::Floor(span / minorStep + 0.000001)
    lastIndex = tickCount
    if closeRing and Math::Abs(tickCount * minorStep - span) < 0.000001
        lastIndex = tickCount - 1
    endif
    lastMajorIndex = Math::Floor(lastIndex / minorCount) * minorCount
    for i from 0 to lastIndex
        skipTick = false
        if i == 0 and division.skipFirstTick
            skipTick = true
        endif
        if i == lastIndex and division.skipLastTick
            skipTick = true
        endif
        if not skipTick
            value = division.valueStart + i * minorStep
            isMajor = (i % minorCount) == 0
            isMedium = false
            if division.mediumEvery > 0 and not isMajor
                isMedium = (i % Math::Round(division.mediumEvery)) == 0
            endif
            hasLabel = false
            if isMajor
                majorIndex = i / minorCount
                hasLabel = (majorIndex % labelEvery) == 0
                if i == 0 and labelFormat.skipFirstLabel
                    hasLabel = false
                endif
                if i == lastMajorIndex and labelFormat.skipLastLabel and not closeRing
                    hasLabel = false
                endif
            endif
            text = ""
            if hasLabel
                if labelFormat.fractionDenominator > 0
                    text = FractionText(value=value denominator=Math::Round(labelFormat.fractionDenominator))
                else
                    text = ValueToString(Math::RoundDecimals(value, labelFormat.decimals))
                endif
            endif
            tick:ScaleTick = {value, (value - division.valueStart) / span, isMajor, isMedium, hasLabel, text}
            append tick to ticks
        endif
    endfor
    return ticks
endprogram

# Rough text width: the engraving font has no exact metric, so use the character width.
function EstimateTextWidth (text:string, charWidth:number) returns number
    return Math::Max(1, String::StringLength(text)) * charWidth
endfunction

@doc: Plans a linear scale: computes all tick lines, the optional baseline and the labels as data.
No machine command is issued. Engrave the result with EngraveScalePlan, or draw it as a preview. @
export program PlanLinearScale (
    scale:LinearScale
        @doc: The linear scale to plan, see NewLinearScale.@
    ) returns ScalePlan
    lines:ScaleLine[] = {}
    arcs:ScaleArc[] = {}
    labels:ScaleLabel[] = {}
    ticks = BuildTicks(division=scale.division labelFormat=scale.labelFormat closeRing=false)
    tickDir = SideSign(scale.side)
    ca = Math::CosDeg(scale.rotationAngle)
    sa = Math::SinDeg(scale.rotationAngle)
    nx = -sa
    ny = ca

    if scale.baselineDepth > 0
        baseline:ScaleLine = {scale.originX, scale.originY, scale.originX + scale.scaleLength * ca, scale.originY + scale.scaleLength * sa, scale.baselineDepth, true}
        append baseline to lines
    endif

    foreach tick in ticks
        u = tick.fraction * scale.scaleLength
        px = scale.originX + u * ca
        py = scale.originY + u * sa
        style = scale.minorTick
        if tick.isMedium
            style = scale.mediumTick
        endif
        if tick.isMajor
            style = scale.majorTick
        endif
        endX = px + tickDir * style.tickLength * nx
        endY = py + tickDir * style.tickLength * ny
        tickLine:ScaleLine = {px, py, endX, endY, style.tickDepth, tick.isMajor}
        append tickLine to lines
        if tick.hasLabel
            dist = tickDir * (scale.majorTick.tickLength + scale.labelFormat.labelOffset + scale.labelFormat.labelHeight / 2)
            labelItem:ScaleLabel = {tick.text, px + dist * nx, py + dist * ny, scale.rotationAngle, scale.labelFormat.labelHeight, scale.labelFormat.labelWidth, scale.labelFormat.labelDepth, LabelAlignment.Center}
            append labelItem to labels
        endif
    endforeach
    return ScalePlan = {lines, arcs, labels}
endprogram

@doc: Plans a circular scale: computes all tick lines, the optional baseline arc and the labels as
data. No machine command is issued. Engrave the result with EngraveScalePlan. @
export program PlanCircularScale (
    scale:CircularScale
        @doc: The circular scale to plan, see NewCircularScale.@
    ) returns ScalePlan
    lines:ScaleLine[] = {}
    arcs:ScaleArc[] = {}
    labels:ScaleLabel[] = {}
    sweep = scale.endAngle - scale.startAngle
    closeRing = Math::Abs(sweep) >= 359.999
    ticks = BuildTicks(division=scale.division labelFormat=scale.labelFormat closeRing=closeRing)
    tickDir = SideSign(scale.side)

    if scale.baselineDepth > 0
        baseArc:ScaleArc = {scale.centerX, scale.centerY, scale.radius, scale.startAngle, scale.endAngle, scale.baselineDepth}
        append baseArc to arcs
    endif

    foreach tick in ticks
        theta = scale.startAngle + tick.fraction * sweep
        nx = Math::CosDeg(theta)
        ny = Math::SinDeg(theta)
        px = scale.centerX + scale.radius * nx
        py = scale.centerY + scale.radius * ny
        style = scale.minorTick
        if tick.isMedium
            style = scale.mediumTick
        endif
        if tick.isMajor
            style = scale.majorTick
        endif
        tickLine:ScaleLine = {px, py, px + tickDir * style.tickLength * nx, py + tickDir * style.tickLength * ny, style.tickDepth, tick.isMajor}
        append tickLine to lines

        if tick.hasLabel
            near = scale.majorTick.tickLength + scale.labelFormat.labelOffset
            rot = 0
            dist = 0
            align = LabelAlignment.Center
            lx = 0
            ly = 0
            if scale.orientation == LabelOrientation.Tangential
                # text up points away from the centre, baseline follows the circle
                dist = scale.radius + tickDir * (near + scale.labelFormat.labelHeight / 2)
                rot = theta - 90
                lx = scale.centerX + dist * nx
                ly = scale.centerY + dist * ny
            endif
            if scale.orientation == LabelOrientation.Horizontal
                half = Math::Abs(nx) * EstimateTextWidth(tick.text, scale.labelFormat.labelWidth) / 2 + Math::Abs(ny) * scale.labelFormat.labelHeight / 2
                dist = scale.radius + tickDir * (near + half)
                rot = 0
                lx = scale.centerX + dist * nx
                ly = scale.centerY + dist * ny
            endif
            if scale.orientation == LabelOrientation.Radial
                # text runs along the radius and is flipped on the left half to stay readable
                dirSign = 1
                rot = theta
                if nx < -0.000001
                    dirSign = -1
                    rot = theta + 180
                endif
                align = LabelAlignment.Right
                if dirSign == tickDir
                    align = LabelAlignment.Left
                endif
                dist = scale.radius + tickDir * near
                lx = scale.centerX + dist * nx
                ly = scale.centerY + dist * ny
            endif
            labelItem:ScaleLabel = {tick.text, lx, ly, rot, scale.labelFormat.labelHeight, scale.labelFormat.labelWidth, scale.labelFormat.labelDepth, align}
            append labelItem to labels
        endif
    endforeach
    return ScalePlan = {lines, arcs, labels}
endprogram

@doc: Creates a fraction scale (inch ruler). Only position, length, values and the unit number text are mandatory.
Tick length and depth are derived from the longest tick (the whole units) and shrink level by level; the finest level
gets 30 percent of the length and 50 percent of the depth. @
export program NewFractionScale (
    originX:number
        @doc: X of the start of the scale.@
    originY:number
        @doc: Y of the start of the scale.@
    scaleLength:number
        @doc: ![](images/scaleLength.png)

Length of the scale from valueStart to valueEnd.@
    valueStart:number
        @doc: Value at the start in whole units, e.g. 0.@
    valueEnd:number
        @doc: Value at the end in whole units, e.g. 6 for 6 inch.@
    unitLabel:LabelSettings
        @doc: ![](images/unitLabel.png)

Text of the big whole-unit numbers, see NewLabelSettings.@
    optional levels:number
        @doc: ![](images/levels.png)

How often the unit is halved: 1 = halves, 2 = quarters, 3 = eighths, 4 = sixteenths. Default: 4.@
    optional tickLength:number
        @doc: ![](images/tickLength.png)

Length of the longest tick (the whole units). Default: 3 x the height of the unit numbers.@
    optional tickDepth:number
        @doc: ![](images/tickDepth.png)

Depth of the longest tick (positive = depth below the surface). Default: 0.2.@
    optional tickStyles:TickStyle[]
        @doc: ![](images/tickStyles.png)

Own tick length and depth per level (levels + 1 entries, whole units first). Replaces tickLength and tickDepth.@
    optional fractionLabel:LabelSettings
        @doc: ![](images/fractionLabel.png)

Text of the small fractions. Default: 60 percent of the size of the unit numbers.@
    optional fractionLabelLevel:number
        @doc: ![](images/fractionLabelLevel.png)

Fractions are written down to this level: 0 = none, 1 = halves, 2 = also quarters. Default: 1.@
    optional rotationAngle:number
        @doc: ![](images/rotationAngle.png)

Direction of the scale in degrees, 0 = along +X. Default: 0.@
    optional side:TickSide
        @doc: ![](images/side_positive.png) ![](images/side_negative.png)

Side of the scale line for ticks and labels. Default: TickSide.Positive.@
    optional skipFirstTick:boolean
        @doc: ![](images/skipFirstTick.png)

Do not engrave the tick and number at valueStart. Default: false.@
    optional skipLastTick:boolean
        @doc: ![](images/skipLastTick.png)

Do not engrave the tick and number at valueEnd. Default: false.@
    optional baselineDepth:number
        @doc: ![](images/baselineDepth.png)

Depth of the scale line in mm (positive = depth below the surface); 0 = not engraved. Default: 0.@
    ) returns FractionScale
    if not levels hasvalue
        levels = 4
    endif
    levels = Math::Max(1, Math::Round(levels))
    if not tickLength hasvalue
        tickLength = unitLabel.labelHeight * 3
    endif
    if not tickDepth hasvalue
        tickDepth = 0.2
    endif
    if not tickStyles hasvalue
        styles:TickStyle[] = {}
        for k from 0 to levels
            levelStyle:TickStyle = {tickLength * (1 - 0.7 * k / levels), tickDepth * (1 - 0.5 * k / levels)}
            append levelStyle to styles
        endfor
        tickStyles = styles
    endif
    if not fractionLabel hasvalue
        fractionLabel = NewLabelSettings(labelHeight=unitLabel.labelHeight * 0.6 labelWidth=unitLabel.labelWidth * 0.6 labelDepth=unitLabel.labelDepth labelOffset=unitLabel.labelOffset * 0.6)
    endif
    if not fractionLabelLevel hasvalue
        fractionLabelLevel = 1
    endif
    if not rotationAngle hasvalue
        rotationAngle = 0
    endif
    if not side hasvalue
        side = TickSide.Positive
    endif
    if not skipFirstTick hasvalue
        skipFirstTick = false
    endif
    if not skipLastTick hasvalue
        skipLastTick = false
    endif
    if not baselineDepth hasvalue
        baselineDepth = 0
    endif
    return FractionScale = {originX, originY, scaleLength, rotationAngle, valueStart, valueEnd, levels, tickStyles, unitLabel, fractionLabel, fractionLabelLevel, side, skipFirstTick, skipLastTick, baselineDepth}
endprogram

@doc: Plans a fraction scale (inch ruler): computes all tick lines, the optional baseline and the labels as data.
Whole units are level 0, halves level 1, quarters level 2 and so on; each level has its own tick style. Whole units
carry the big numbers, the levels up to fractionLabelLevel carry the small fractions (e.g. 3/4). No machine command
is issued. Engrave the result with EngraveScalePlan. @
export program PlanFractionScale (
    scale:FractionScale
        @doc: The fraction scale to plan, see NewFractionScale.@
    ) returns ScalePlan
    lines:ScaleLine[] = {}
    arcs:ScaleArc[] = {}
    labels:ScaleLabel[] = {}
    levels = Math::Max(1, Math::Round(scale.levels))
    perUnit = Math::Pow(2, levels)
    span = scale.valueEnd - scale.valueStart
    tickCount = Math::Round(span * perUnit)
    lastIndex = tickCount
    tickDir = SideSign(scale.side)
    ca = Math::CosDeg(scale.rotationAngle)
    sa = Math::SinDeg(scale.rotationAngle)
    nx = -sa
    ny = ca
    unitEvery = Math::Max(1, Math::Round(scale.unitLabel.labelEvery))

    if scale.baselineDepth > 0
        baseline:ScaleLine = {scale.originX, scale.originY, scale.originX + scale.scaleLength * ca, scale.originY + scale.scaleLength * sa, scale.baselineDepth, true}
        append baseline to lines
    endif

    for i from 0 to lastIndex
        skipTick = false
        if i == 0 and scale.skipFirstTick
            skipTick = true
        endif
        if i == lastIndex and scale.skipLastTick
            skipTick = true
        endif
        if not skipTick
            # level of the tick = how many halvings are needed to reach it
            level = 0
            if (i % perUnit) <> 0
                rest = i
                halvings = 0
                while (rest % 2) == 0
                    rest = rest / 2
                    halvings = halvings + 1
                endwhile
                level = levels - halvings
            endif
            value = scale.valueStart + i / perUnit
            u = i / tickCount * scale.scaleLength
            px = scale.originX + u * ca
            py = scale.originY + u * sa
            style = scale.tickStyles[level]
            tickLine:ScaleLine = {px, py, px + tickDir * style.tickLength * nx, py + tickDir * style.tickLength * ny, style.tickDepth, level == 0}
            append tickLine to lines

            labelText = ""
            textStyle = scale.unitLabel
            if level == 0
                unitIndex = i / perUnit
                wanted = (unitIndex % unitEvery) == 0
                if i == 0 and scale.unitLabel.skipFirstLabel
                    wanted = false
                endif
                if i == lastIndex and scale.unitLabel.skipLastLabel
                    wanted = false
                endif
                if wanted
                    labelText = ValueToString(Math::RoundDecimals(value, scale.unitLabel.decimals))
                endif
            else
                if level <= scale.fractionLabelLevel
                    labelText = FractionText(value=value - Math::Floor(value) denominator=perUnit)
                    textStyle = scale.fractionLabel
                endif
            endif
            if labelText <> ""
                dist = tickDir * (style.tickLength + textStyle.labelOffset + textStyle.labelHeight / 2)
                labelItem:ScaleLabel = {labelText, px + dist * nx, py + dist * ny, scale.rotationAngle, textStyle.labelHeight, textStyle.labelWidth, textStyle.labelDepth, LabelAlignment.Center}
                append labelItem to labels
            endif
        endif
    endfor
    return ScalePlan = {lines, arcs, labels}
endprogram
# ---------------------------------------------------------------------------------------
# Execution layer
# ---------------------------------------------------------------------------------------

@doc: Engraves one straight line at the current Feed: up to the retract height, rapid over the start, rapid down to the approach height, feed down to the depth, cut horizontally to the end, up again. @
program CutLine (
    lineSeg:ScaleLine
        @doc: The line to engrave.@
    heights:EngraveHeights
        @doc: Clearance height for the moves between engravings.@
    )
    Rapid Z=heights.retractZ
    Rapid X=lineSeg.x1 Y=lineSeg.y1
    Rapid Z=heights.approachZ
    Line Z=-lineSeg.lineDepth
    Line X=lineSeg.x2 Y=lineSeg.y2
    Rapid Z=heights.retractZ
endprogram

@doc: Engraves a circular arc at the current Feed. Arcs are cut in segments of at most 90 degrees
so that every segment is unambiguous. @
program CutArc (
    arcSeg:ScaleArc
        @doc: The arc to engrave.@
    heights:EngraveHeights
        @doc: Clearance height for the moves between engravings.@
    )
    sweep = arcSeg.arcEnd - arcSeg.arcStart
    segments = Math::Ceiling(Math::Abs(sweep) / 90)
    segSweep = sweep / segments
    Rapid Z=heights.retractZ
    Rapid X=arcSeg.arcCenterX + arcSeg.arcRadius * Math::CosDeg(arcSeg.arcStart) Y=arcSeg.arcCenterY + arcSeg.arcRadius * Math::SinDeg(arcSeg.arcStart)
    Rapid Z=heights.approachZ
    Line Z=-arcSeg.arcDepth
    for k from 1 to segments
        fromAngle = arcSeg.arcStart + (k - 1) * segSweep
        toAngle = arcSeg.arcStart + k * segSweep
        startX = arcSeg.arcCenterX + arcSeg.arcRadius * Math::CosDeg(fromAngle)
        startY = arcSeg.arcCenterY + arcSeg.arcRadius * Math::SinDeg(fromAngle)
        endX = arcSeg.arcCenterX + arcSeg.arcRadius * Math::CosDeg(toAngle)
        endY = arcSeg.arcCenterY + arcSeg.arcRadius * Math::SinDeg(toAngle)
        if sweep > 0
            Arc CCW X=endX Y=endY dX=arcSeg.arcCenterX - startX dY=arcSeg.arcCenterY - startY
        else
            Arc CW X=endX Y=endY dX=arcSeg.arcCenterX - startX dY=arcSeg.arcCenterY - startY
        endif
    endfor
    Rapid Z=heights.retractZ
endprogram

@doc: Engraves one label with Engrave::StandardTextEngrave at its position. The command brings its own approach and counts downwards: depth is positive into the material, and strokeCuttingZ is measured like the depth (positive = below the surface; the final cut is at -(strokeCuttingZ + depth), observed on the control). To start the feed move at approachZ ABOVE the surface and still end at textDepth below it, the label is engraved with strokeCuttingZ = -approachZ and depth = textDepth + approachZ. strokeRapidZ (rapid moves between the strokes) is retractZ. @
program CutLabel (
    item:ScaleLabel
        @doc: The label to engrave.@
    heights:EngraveHeights
        @doc: Clearance height for the moves between engravings.@
    )
    alignment = HorizontalAlignment.Center
    if item.alignment == LabelAlignment.Left
        alignment = HorizontalAlignment.Left
    endif
    if item.alignment == LabelAlignment.Right
        alignment = HorizontalAlignment.Right
    endif
    Rapid Z=heights.retractZ
    Rapid X=item.x Y=item.y
    StandardTextEngrave text=item.text charHeight=item.textHeight charWidth=item.textWidth depth=item.textDepth + heights.approachZ strokeRapidZ=heights.retractZ strokeCuttingZ=-heights.approachZ rotation=item.rotation textPosition=alignment
endprogram

@doc: Engraves a plan: baseline arcs, then all tick lines in scale order, then the labels.
Pure motion: the caller selects the tool and sets Rpm, Feed and Spindle On before the call and
Spindle Off after it. Plunges and cuts use the current Feed. The work coordinate system must have
Z = 0 on the surface. @
export program EngraveScalePlan (
    plan:ScalePlan
        @doc: The plan to engrave, from PlanLinearScale or PlanCircularScale.@
    heights:EngraveHeights
        @doc: Clearance and final retract heights, see NewEngraveHeights.@
    )
    Absolute
    first = true
    foreach arcItem in plan.arcs
        if first
            PrePositioning X=arcItem.arcCenterX + arcItem.arcRadius * Math::CosDeg(arcItem.arcStart) Y=arcItem.arcCenterY + arcItem.arcRadius * Math::SinDeg(arcItem.arcStart) Z=heights.retractZ
            first = false
        endif
        CutArc arcSeg=arcItem heights=heights
    endforeach
    foreach lineItem in plan.lines
        if first
            PrePositioning X=lineItem.x1 Y=lineItem.y1 Z=heights.retractZ
            first = false
        endif
        CutLine lineSeg=lineItem heights=heights
    endforeach
    foreach labelItem in plan.labels
        if first
            PrePositioning X=labelItem.x Y=labelItem.y Z=heights.retractZ
            first = false
        endif
        CutLabel item=labelItem heights=heights
    endforeach
    Rapid Z=heights.safeZ
endprogram

@doc: Plans and engraves a linear scale (ruler). The caller sets tool, Rpm, Feed and Spindle On first. @
export program EngraveLinearScale (
    scale:LinearScale
        @doc: The linear scale, see NewLinearScale.@
    heights:EngraveHeights
        @doc: Clearance and final retract heights, see NewEngraveHeights.@
    )
    plan = PlanLinearScale(scale=scale)
    EngraveScalePlan plan=plan heights=heights
endprogram

@doc: Plans and engraves a circular scale (dial). The caller sets tool, Rpm, Feed and Spindle On first. @
export program EngraveCircularScale (
    scale:CircularScale
        @doc: The circular scale, see NewCircularScale.@
    heights:EngraveHeights
        @doc: Clearance and final retract heights, see NewEngraveHeights.@
    )
    plan = PlanCircularScale(scale=scale)
    EngraveScalePlan plan=plan heights=heights
endprogram

@doc: Plans and engraves a fraction scale (inch ruler). The caller sets tool, Rpm, Feed and Spindle On first and Spindle Off afterwards. @
export program EngraveFractionScale (
    scale:FractionScale
        @doc: The fraction scale, see NewFractionScale.@
    heights:EngraveHeights
        @doc: Clearance and final retract heights, see NewEngraveHeights.@
    )
    plan = PlanFractionScale(scale=scale)
    EngraveScalePlan plan=plan heights=heights
endprogram

end
