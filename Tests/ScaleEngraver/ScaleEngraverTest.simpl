module ScaleEngraverTest

@ Author = "Benjamin Boeck" @
@ MeasuringSystem = "Metric" @

# Tests of the planning layer of ScaleEngraverCore (the engine behind EngraveRuler and EngraveDial). No machine motion is executed: the plans are
# computed and checked as data. A failed check raises InvalidArgumentValue with a message.

using Base
using ScaleEngraverCore
import System
import Math

program Expect (condition:boolean message:string)
    if not condition
        System::RaiseError InvalidArgumentValue englishErrorDetails=message
    endif
endprogram

program IsClose (actual:number expected:number) returns boolean
    return Math::Abs(actual - expected) < 0.0001
endprogram

export program Main
    majorTick = NewTickStyle(tickLength=6 tickDepth=0.2)
    minorTick = NewTickStyle(tickLength=3 tickDepth=0.1)

    # Linear 0..100, 10 minor intervals per major interval -> 101 ticks, plus the baseline
    division = NewScaleDivision(valueStart=0 valueEnd=100 majorStep=10 minorDivisions=10)
    labels = NewLabelSettings(labelHeight=3)
    linear = NewLinearScale(originX=10 originY=20 scaleLength=100 division=division majorTick=majorTick minorTick=minorTick labelFormat=labels baselineDepth=0.1)
    plan = PlanLinearScale(scale=linear)
    Expect condition=(sizeof plan.lines == 102) message="linear: expected 101 ticks and the baseline"
    Expect condition=(sizeof plan.labels == 11) message="linear: expected 11 labels"
    Expect condition=(plan.labels[0].text == "0") message="linear: first label text"
    Expect condition=IsClose(actual=plan.labels[10].x expected=110) message="linear: last label x"
    Expect condition=IsClose(actual=plan.labels[0].y expected=28.4) message="linear: label sits above the major tick"

    # Skipping labels on the borders
    skipLabels = NewLabelSettings(labelHeight=3 skipFirstLabel=1 skipLastLabel=1)
    skipScale = NewLinearScale(originX=10 originY=20 scaleLength=100 division=division majorTick=majorTick minorTick=minorTick labelFormat=skipLabels)
    skipPlan = PlanLinearScale(scale=skipScale)
    Expect condition=(sizeof skipPlan.labels == 9) message="linear: first and last label skipped"
    Expect condition=(skipPlan.labels[0].text == "10") message="linear: first remaining label"

    # Label every second major tick
    everyLabels = NewLabelSettings(labelHeight=3 labelEvery=2)
    everyScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=division majorTick=majorTick minorTick=minorTick labelFormat=everyLabels)
    everyPlan = PlanLinearScale(scale=everyScale)
    Expect condition=(sizeof everyPlan.labels == 6) message="linear: label every second major tick"

    # Ticks and labels below the line
    downScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=division majorTick=majorTick minorTick=minorTick labelFormat=labels side=TickSide.Negative)
    downPlan = PlanLinearScale(scale=downScale)
    Expect condition=(downPlan.lines[0].y2 < 0) message="linear: ticks point down"
    Expect condition=(downPlan.labels[0].y < -6) message="linear: labels below the ticks"


    # Skipping the first and last tick removes the tick and its label
    skipTickDivision = NewScaleDivision(valueStart=0 valueEnd=100 majorStep=10 minorDivisions=10 skipFirstTick=1 skipLastTick=1)
    skipTickScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=skipTickDivision majorTick=majorTick minorTick=minorTick labelFormat=labels)
    skipTickPlan = PlanLinearScale(scale=skipTickScale)
    Expect condition=(sizeof skipTickPlan.lines == 99) message="linear: first and last tick skipped"
    Expect condition=(sizeof skipTickPlan.labels == 9) message="linear: labels of skipped ticks removed"
    Expect condition=IsClose(actual=skipTickPlan.lines[0].x1 expected=1) message="linear: first remaining tick is at 1"

    # Medium ticks: every 5th minor interval, major ticks win where both coincide
    mediumTick = NewTickStyle(tickLength=4.5 tickDepth=0.15)
    mediumDivision = NewScaleDivision(valueStart=0 valueEnd=100 majorStep=10 minorDivisions=10 mediumEvery=5)
    mediumScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=mediumDivision majorTick=majorTick minorTick=minorTick mediumTick=mediumTick labelFormat=labels)
    mediumPlan = PlanLinearScale(scale=mediumScale)
    Expect condition=(sizeof mediumPlan.lines == 101) message="linear: medium ticks do not add ticks"
    Expect condition=IsClose(actual=mediumPlan.lines[5].y2 expected=4.5) message="linear: tick at 5 has the medium length"
    Expect condition=IsClose(actual=mediumPlan.lines[10].y2 expected=6) message="linear: tick at 10 stays major"
    Expect condition=IsClose(actual=mediumPlan.lines[3].y2 expected=3) message="linear: tick at 3 stays minor"
    defaultMediumScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=mediumDivision majorTick=majorTick minorTick=minorTick labelFormat=labels)
    defaultMediumPlan = PlanLinearScale(scale=defaultMediumScale)
    Expect condition=IsClose(actual=defaultMediumPlan.lines[5].y2 expected=4.5) message="linear: default medium tick is halfway between major and minor"

    # Fractions for inch scales: eighths, reduced, mixed numbers
    fractionLabels = NewLabelSettings(labelHeight=3 fractionDenominator=8)
    fractionDivision = NewScaleDivision(valueStart=0 valueEnd=2 majorStep=0.125 minorDivisions=1)
    eighthsScale = NewLinearScale(originX=0 originY=0 scaleLength=200 division=fractionDivision majorTick=majorTick minorTick=minorTick labelFormat=fractionLabels)
    eighthsPlan = PlanLinearScale(scale=eighthsScale)
    Expect condition=(eighthsPlan.labels[0].text == "0") message="fraction: 0"
    Expect condition=(eighthsPlan.labels[1].text == "1/8") message="fraction: 1/8"
    Expect condition=(eighthsPlan.labels[2].text == "1/4") message="fraction: 2/8 is reduced to 1/4"
    Expect condition=(eighthsPlan.labels[3].text == "3/8") message="fraction: 3/8"
    Expect condition=(eighthsPlan.labels[4].text == "1/2") message="fraction: 4/8 is reduced to 1/2"
    Expect condition=(eighthsPlan.labels[8].text == "1") message="fraction: whole number has no fraction part"
    Expect condition=(eighthsPlan.labels[12].text == "1 1/2") message="fraction: mixed number"

    # Fraction scale (inch ruler): 0..2 inch, halved 3 times (eighths), fractions labelled down to the quarters
    unitLabels = NewLabelSettings(labelHeight=3 skipFirstLabel=1)
    fraction = NewFractionScale(originX=0 originY=0 scaleLength=200 valueStart=0 valueEnd=2 unitLabel=unitLabels levels=3 tickLength=8 tickDepth=0.2 fractionLabelLevel=2)
    fractionRuler = PlanFractionScale(scale=fraction)
    Expect condition=(sizeof fractionRuler.lines == 17) message="fraction scale: 2 inch in eighths = 17 ticks"
    Expect condition=IsClose(actual=fractionRuler.lines[8].y2 expected=8) message="fraction scale: whole inch has the longest tick"
    Expect condition=IsClose(actual=fractionRuler.lines[4].y2 expected=6.1333) message="fraction scale: half inch tick"
    Expect condition=IsClose(actual=fractionRuler.lines[2].y2 expected=4.2667) message="fraction scale: quarter inch tick"
    Expect condition=IsClose(actual=fractionRuler.lines[1].y2 expected=2.4) message="fraction scale: eighth inch tick is the shortest"
    Expect condition=(sizeof fractionRuler.labels == 8) message="fraction scale: numbers 1 2, halves 2x, quarters 4x"
    Expect condition=(fractionRuler.labels[0].text == "1/4") message="fraction scale: first label is 1/4 (the 0 is skipped, eighths have no label)"
    Expect condition=(fractionRuler.labels[1].text == "1/2") message="fraction scale: 1/2"
    Expect condition=(fractionRuler.labels[2].text == "3/4") message="fraction scale: 3/4 without the whole number"
    Expect condition=(fractionRuler.labels[3].text == "1") message="fraction scale: whole inch is a number"
    Expect condition=IsClose(actual=fractionRuler.labels[3].textHeight expected=3) message="fraction scale: unit number size"
    Expect condition=IsClose(actual=fractionRuler.labels[0].textHeight expected=1.8) message="fraction scale: fractions are 60 percent as big"
    Expect condition=(fractionRuler.labels[7].text == "2") message="fraction scale: last number"

    # Full circle: the closing tick at 360 is not engraved a second time
    dialDivision = NewScaleDivision(valueStart=0 valueEnd=360 majorStep=30 minorDivisions=6)
    dial = NewCircularScale(centerX=0 centerY=0 radius=40 division=dialDivision majorTick=majorTick minorTick=minorTick labelFormat=labels baselineDepth=0.1)
    dialPlan = PlanCircularScale(scale=dial)
    Expect condition=(sizeof dialPlan.lines == 72) message="circular: 72 ticks for a full circle"
    Expect condition=(sizeof dialPlan.labels == 12) message="circular: 12 labels for a full circle"
    Expect condition=(sizeof dialPlan.arcs == 1) message="circular: baseline arc"
    Expect condition=IsClose(actual=dialPlan.lines[0].x1 expected=0) message="circular: 0 is at 12 o'clock (x)"
    Expect condition=IsClose(actual=dialPlan.lines[0].y1 expected=40) message="circular: 0 is at 12 o'clock (y)"
    Expect condition=IsClose(actual=dialPlan.labels[6].rotation expected=-180) message="circular: tangential label rotation at 6 o'clock"

    # Partial arc keeps both end ticks
    partialDivision = NewScaleDivision(valueStart=0 valueEnd=270 majorStep=45 minorDivisions=5)
    partial = NewCircularScale(centerX=0 centerY=0 radius=40 division=partialDivision majorTick=majorTick minorTick=minorTick labelFormat=labels startAngle=225 endAngle=-45)
    partialPlan = PlanCircularScale(scale=partial)
    Expect condition=(sizeof partialPlan.lines == 31) message="circular: partial arc keeps both end ticks"


    TestOwnScales
endprogram

# Own value ranges, the clock face, the angle scale and the skip counts
program TestOwnScales
    majorTick = NewTickStyle(tickLength=6 tickDepth=0.2)
    minorTick = NewTickStyle(tickLength=3 tickDepth=0.1)
    labels = NewLabelSettings(labelHeight=3)

    # Own value range: ticks sit on multiples of the step, the first tick is the first one inside the range
    rangeDivision = NewScaleDivision(valueStart=15 valueEnd=85 majorStep=10 minorDivisions=10)
    rangeScale = NewLinearScale(originX=0 originY=0 scaleLength=70 division=rangeDivision majorTick=majorTick minorTick=minorTick labelFormat=labels)
    rangePlan = PlanLinearScale(scale=rangeScale)
    Expect condition=(sizeof rangePlan.lines == 71) message="range: 15 to 85 has 71 ticks"
    Expect condition=(sizeof rangePlan.labels == 7) message="range: numbers 20 to 80"
    Expect condition=(rangePlan.labels[0].text == "20") message="range: first number is 20"
    Expect condition=IsClose(actual=rangePlan.labels[0].x expected=5) message="range: 20 sits 5 mm from the start"
    negativeDivision = NewScaleDivision(valueStart=-50 valueEnd=50 majorStep=10 minorDivisions=10)
    negativeScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=negativeDivision majorTick=majorTick minorTick=minorTick labelFormat=labels)
    negativePlan = PlanLinearScale(scale=negativeScale)
    Expect condition=(sizeof negativePlan.labels == 11) message="range: -50 to 50 has 11 numbers"
    Expect condition=(negativePlan.labels[0].text == "-50") message="range: first number is -50"
    Expect condition=(negativePlan.labels[5].text == "0") message="range: zero in the middle"
    Expect condition=IsClose(actual=negativePlan.labels[5].x expected=50) message="range: zero sits in the middle"

    # Clock face: values 1 to 13 over a full turn, the tick at 13 is the one at 1 and is not engraved twice
    clockDivision = NewScaleDivision(valueStart=1 valueEnd=13 majorStep=1 minorDivisions=5)
    clock = NewCircularScale(centerX=0 centerY=0 radius=40 division=clockDivision majorTick=majorTick minorTick=minorTick labelFormat=labels startAngle=60 endAngle=-300)
    clockPlan = PlanCircularScale(scale=clock)
    Expect condition=(sizeof clockPlan.lines == 60) message="clock: 60 minute ticks"
    Expect condition=(sizeof clockPlan.labels == 12) message="clock: 12 hour numbers"
    Expect condition=(clockPlan.labels[0].text == "1") message="clock: first number is 1"
    Expect condition=(clockPlan.labels[11].text == "12") message="clock: last number is 12"
    Expect condition=IsClose(actual=clockPlan.lines[55].x1 expected=0) message="clock: 12 is at 12 o'clock (x)"
    Expect condition=IsClose(actual=clockPlan.lines[55].y1 expected=40) message="clock: 12 is at 12 o'clock (y)"

    # Angle scale on a straight (speed square): the tick of the angle a sits at distance * tan(a)
    angleDivision = NewScaleDivision(valueStart=0 valueEnd=45 majorStep=10 minorDivisions=10 mediumEvery=5)
    angleScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=angleDivision majorTick=majorTick minorTick=minorTick labelFormat=labels angleDistance=100)
    anglePlan = PlanLinearScale(scale=angleScale)
    Expect condition=(sizeof anglePlan.lines == 46) message="angle scale: a tick every degree from 0 to 45"
    Expect condition=IsClose(actual=anglePlan.lines[10].x1 expected=17.6327) message="angle scale: 10 degrees at 100 * tan(10)"
    Expect condition=IsClose(actual=anglePlan.lines[45].x1 expected=100) message="angle scale: 45 degrees at the distance"
    Expect condition=IsClose(actual=anglePlan.lines[45].x2 expected=100 - 4.5 * 0.70710678) message="angle scale: the 45 degree tick points to the pivot (x)"
    Expect condition=IsClose(actual=anglePlan.lines[45].y2 expected=4.5 * 0.70710678) message="angle scale: the 45 degree tick points to the pivot (y)"
    Expect condition=IsClose(actual=anglePlan.lines[0].x2 expected=0) message="angle scale: the 0 degree tick is across the line"
    Expect condition=(sizeof anglePlan.labels == 5) message="angle scale: numbers 0 10 20 30 40"
    Expect condition=(anglePlan.labels[2].text == "20") message="angle scale: third number is 20"
    shiftedDivision = NewScaleDivision(valueStart=15 valueEnd=60 majorStep=5 minorDivisions=5)
    shiftedScale = NewLinearScale(originX=10 originY=0 scaleLength=44.6 division=shiftedDivision majorTick=majorTick minorTick=minorTick labelFormat=labels angleDistance=60)
    shiftedPlan = PlanLinearScale(scale=shiftedScale)
    Expect condition=IsClose(actual=shiftedPlan.lines[0].x1 expected=10) message="angle scale: the first tick sits at the origin"
    Expect condition=IsClose(actual=shiftedPlan.lines[45].x1 expected=10 + 60 * (1.7320508 - 0.2679492)) message="angle scale: 60 degrees relative to 15 degrees"
    # Angle scale with an offset: the values count from the start point, the geometry keeps the true angles
    offsetDivision = NewScaleDivision(valueStart=0 valueEnd=30 majorStep=10 minorDivisions=10)
    offsetScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=offsetDivision majorTick=majorTick minorTick=minorTick labelFormat=labels angleDistance=100 angleOffset=20)
    offsetPlan = PlanLinearScale(scale=offsetScale)
    Expect condition=IsClose(actual=offsetPlan.lines[0].x1 expected=0) message="angle offset: the first tick sits at the origin"
    Expect condition=IsClose(actual=offsetPlan.lines[10].x1 expected=100 * (0.57735027 - 0.36397023)) message="angle offset: value 10 is the true angle 30"
    Expect condition=IsClose(actual=offsetPlan.lines[0].x2 expected=-6 * 0.34202014) message="angle offset: the first tick leans by the true angle 20"
    # Leaving out several ticks at the start and at the end
    manyDivision = NewScaleDivision(valueStart=0 valueEnd=100 majorStep=10 minorDivisions=10 skipFirstTick=3 skipLastTick=2)
    manyScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=manyDivision majorTick=majorTick minorTick=minorTick labelFormat=labels)
    manyPlan = PlanLinearScale(scale=manyScale)
    Expect condition=(sizeof manyPlan.lines == 96) message="skip: 101 ticks minus 3 at the start and 2 at the end"
    Expect condition=IsClose(actual=manyPlan.lines[0].x1 expected=3) message="skip: the first tick left is at 3"
    Expect condition=IsClose(actual=manyPlan.lines[95].x1 expected=98) message="skip: the last tick left is at 98"
    manyLabelCount = sizeof manyPlan.labels
    Expect condition=(manyLabelCount == 9) message="skip: nine numbers stay"
    # Leaving out several numbers: the ticks stay
    fewLabels = NewLabelSettings(labelHeight=3 skipFirstLabel=2 skipLastLabel=3)
    fewDivision = NewScaleDivision(valueStart=0 valueEnd=100 majorStep=10 minorDivisions=10)
    fewScale = NewLinearScale(originX=0 originY=0 scaleLength=100 division=fewDivision majorTick=majorTick minorTick=minorTick labelFormat=fewLabels)
    fewPlan = PlanLinearScale(scale=fewScale)
    fewTickCount = sizeof fewPlan.lines
    fewLabelCount = sizeof fewPlan.labels
    Expect condition=(fewTickCount == 101) message="skip numbers: all ticks stay"
    Expect condition=(fewLabelCount == 6) message="skip numbers: 11 numbers minus 2 at the start and 3 at the end"
    Expect condition=(fewPlan.labels[0].text == "20") message="skip numbers: the first number left is 20"
    Expect condition=(fewPlan.labels[5].text == "70") message="skip numbers: the last number left is 70"
endprogram

end
